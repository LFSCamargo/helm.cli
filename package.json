{
  "name": "helm-cli",
  "version": "0.1.0",
  "description": "A stunning terminal cockpit to manage reusable prompts and todos, built with React + Ink.",
  "type": "module",
  "bin": {
    "helm": "./dist/cli.js"
  },
  "packageManager": "pnpm@10.15.1",
  "engines": {
    "node": ">=20",
    "pnpm": ">=10",
    "npm": "please-use-pnpm",
    "yarn": "please-use-pnpm"
  },
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "dev": "tsx src/cli.tsx",
    "build": "tsc",
    "start": "node dist/cli.js",
    "typecheck": "tsc --noEmit",
    "types:check": "tsc --noEmit",
    "lint": "eslint src",
    "lint:check": "eslint src",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "unitary:test": "vitest run --project unit",
    "integration:test": "vitest run --project integration",
    "test:coverage": "vitest run --coverage --project unit --project integration",
    "quality": "pnpm format:check && pnpm lint:check && pnpm types:check && pnpm unitary:test && pnpm integration:test && pnpm test:coverage"
  },
  "keywords": [
    "cli",
    "ink",
    "react",
    "prompts",
    "todo",
    "tui"
  ],
  "license": "MIT",
  "dependencies": {
    "better-sqlite3": "^11.8.1",
    "clipboardy": "^4.0.0",
    "ink": "^5.1.0",
    "ink-gradient": "^3.0.0",
    "ink-spinner": "^5.0.0",
    "ink-text-input": "^6.0.0",
    "kysely": "^0.27.5",
    "nanoid": "^5.0.9",
    "node-notifier": "^10.0.1",
    "react": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.5",
    "@types/node-notifier": "^8.0.5",
    "@types/react": "^18.3.18",
    "@vitest/coverage-v8": "^3.0.7",
    "eslint": "^9.21.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "ink-testing-library": "^4.0.0",
    "nx": "^22.7.5",
    "prettier": "^3.5.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.26.0",
    "vitest": "^3.0.7"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild",
      "nx"
    ]
  },
  "nx": {
    "targets": {
      "build": {
        "outputs": [
          "{projectRoot}/dist"
        ],
        "cache": true
      },
      "typecheck": {
        "cache": true
      },
      "types:check": {
        "executor": "nx:run-script",
        "options": {
          "script": "types:check"
        },
        "cache": true
      },
      "lint:check": {
        "executor": "nx:run-script",
        "options": {
          "script": "lint:check"
        },
        "cache": true
      },
      "format:check": {
        "executor": "nx:run-script",
        "options": {
          "script": "format:check"
        },
        "cache": true
      },
      "test:unit": {
        "executor": "nx:run-script",
        "options": {
          "script": "test:unit"
        },
        "cache": true
      },
      "test:integration": {
        "executor": "nx:run-script",
        "options": {
          "script": "test:integration"
        },
        "cache": true
      },
      "unitary:test": {
        "executor": "nx:run-script",
        "options": {
          "script": "unitary:test"
        },
        "cache": true
      },
      "integration:test": {
        "executor": "nx:run-script",
        "options": {
          "script": "integration:test"
        },
        "cache": true
      },
      "test:coverage": {
        "executor": "nx:run-script",
        "options": {
          "script": "test:coverage"
        },
        "cache": true
      },
      "quality": {
        "executor": "nx:run-script",
        "options": {
          "script": "quality"
        },
        "cache": false
      }
    }
  }
}
