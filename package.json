{
  "name": "helm-cli",
  "version": "0.1.0",
  "description": "A stunning terminal cockpit to manage reusable prompts and todos, built with React + Ink.",
  "type": "module",
  "bin": {
    "helm": "./dist/cli.js"
  },
  "packageManager": "pnpm@10.15.1",
  "engines": {
    "node": ">=20",
    "pnpm": ">=10",
    "npm": "please-use-pnpm",
    "yarn": "please-use-pnpm"
  },
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "dev": "tsx src/cli.tsx",
    "build": "tsc",
    "start": "node dist/cli.js",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "cli",
    "ink",
    "react",
    "prompts",
    "todo",
    "tui"
  ],
  "license": "MIT",
  "dependencies": {
    "better-sqlite3": "^11.8.1",
    "clipboardy": "^4.0.0",
    "ink": "^5.1.0",
    "ink-gradient": "^3.0.0",
    "ink-spinner": "^5.0.0",
    "ink-text-input": "^6.0.0",
    "kysely": "^0.27.5",
    "nanoid": "^5.0.9",
    "node-notifier": "^10.0.1",
    "react": "^18.3.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.5",
    "@types/node-notifier": "^8.0.5",
    "@types/react": "^18.3.18",
    "ink-testing-library": "^4.0.0",
    "nx": "^22.7.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild",
      "nx"
    ]
  },
  "nx": {
    "targets": {
      "build": {
        "outputs": ["{projectRoot}/dist"],
        "cache": true
      },
      "typecheck": {
        "cache": true
      }
    }
  }
}
